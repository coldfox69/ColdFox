# ─────────────────────────────────────────────────────────────
# ColdFox environment variables (names only — never commit values)
# Copy to .env.local for development; set in Vercel for production.
# ─────────────────────────────────────────────────────────────

# Application
NEXT_PUBLIC_APP_URL=https://your-domain.example
NODE_ENV=production

# Supabase (public values are safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# Supabase Management API (migrations / scripts only)
SUPABASE_ACCESS_TOKEN=

# Groq AI (server only)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Encryption / signing secrets (generate with: openssl rand -base64 32)
MAILBOX_ENCRYPTION_KEY=
UNSUBSCRIBE_TOKEN_SECRET=
OAUTH_STATE_SECRET=
CRON_SECRET=

# Admin bootstrap (email of an existing user to grant platform admin)
ADMIN_BOOTSTRAP_EMAIL=

# Sending identity defaults
EMAIL_FROM_NAME=ColdFox
EMAIL_FROM_ADDRESS=
SMTP_TEST_MODE=true

# Gmail OAuth (optional until Google Cloud project is configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Graph OAuth (optional until Entra app is configured)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Billing (not enabled until a provider account is supplied)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_PROVIDER=
