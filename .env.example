# ─────────────────────────────────────────────────────────────
# ColdFox environment variables (names only — never commit values)
# Copy to .env.local for development; set in Vercel for production.
# ─────────────────────────────────────────────────────────────

# Application
NEXT_PUBLIC_APP_URL=https://your-domain.example
NODE_ENV=production

# Supabase (public values are safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# Supabase Management API (migrations / scripts only)
SUPABASE_ACCESS_TOKEN=

# Groq AI (server only)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Encryption / signing secrets (generate with: openssl rand -base64 32)
MAILBOX_ENCRYPTION_KEY=
UNSUBSCRIBE_TOKEN_SECRET=
OAUTH_STATE_SECRET=
CRON_SECRET=

# Admin bootstrap (email of an existing user to grant platform admin)
ADMIN_BOOTSTRAP_EMAIL=

# Sending identity defaults
EMAIL_FROM_NAME=ColdFox
EMAIL_FROM_ADDRESS=
SMTP_TEST_MODE=true

# Gmail OAuth (optional until Google Cloud project is configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Graph OAuth (optional until Entra app is configured)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Billing (not enabled until a provider account is supplied)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_PROVIDER=

# ─────────────────────────────────────────────────────────────
# Performance and observability (all optional)
# ─────────────────────────────────────────────────────────────

# The app talks to Postgres over Supabase's pooled PostgREST endpoint, so it
# never opens raw database connections and no pool tuning is needed here.
# Only set this if a direct connection is ever added: use the pooler URL
# (port 6543) so the app cannot exhaust the connection limit.
SUPABASE_DB_URL=

# Threshold in milliseconds before a backend request is logged as slow.
# Every API route is traced automatically.
SLOW_REQUEST_MS=1500

# OpenTelemetry collector. When set, slow-request spans are exported over
# OTLP/HTTP as JSON and show up in any OTLP-compatible backend (Jaeger,
# Tempo, Honeycomb). Leave it empty to only log slow requests.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=coldfox

# Optional shared cache. Without it the app uses its in-process cache and
# the shared Postgres cache table.
REDIS_URL=

# Vercel region. Keep it close to the database region for lower latency.
VERCEL_REGION=hnd1

# ─────────────────────────────────────────────────────────────
# Background job queue
# ─────────────────────────────────────────────────────────────

# The queue itself needs no configuration: it runs on the existing
# background_jobs table. It is drained by the routes that already use
# CRON_SECRET above (/api/cron/jobs and /api/cron/worker).

# Safe send mode for tests and demos. When true, the send engine runs the full
# pipeline but never calls a provider; each recipient is marked accepted with a
# synthetic test-message-* id. Leave unset in production.
# EMAIL_TEST_MODE=true

